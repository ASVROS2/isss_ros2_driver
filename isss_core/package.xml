<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>isss_core</name>
  <version>0.2.0</version>
  <description>ROS-free protocol, client, driver loop and simulator for the DeepVision ISSS (Python module `isss`)</description>
  <maintainer email="jvaldez@kth.se">Julian Valdez</maintainer>
  <license>MIT</license>

  <!-- only for isss-report / isss-view; the driver itself is stdlib-only -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
