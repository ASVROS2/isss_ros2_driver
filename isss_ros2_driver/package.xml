<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>isss_ros2_driver</name>
  <version>0.2.0</version>
  <description>ROS 2 driver and processing node for the DeepVision Interferometric Side Scan Sonar (ISSS): thin wrappers around isss_core and isss_proc</description>
  <maintainer email="ignaciotorroba@hotmail.com">Ignacio Torroba</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>isss_core</exec_depend>
  <exec_depend>isss_proc</exec_depend>
  <exec_depend>isss_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
