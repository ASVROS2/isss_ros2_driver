<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>isss_ros2_driver</name>
  <version>0.2.0</version>
  <description>ROS 2 driver for the DeepVision Interferometric Side Scan Sonar (ISSS): a thin wrapper around isss_core</description>
  <maintainer email="ignaciotorroba@hotmail.com">Ignacio Torroba</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>smarc_msgs</exec_depend>
  <exec_depend>isss_core</exec_depend>
  <exec_depend>isss_ros2_driver_interfaces</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
