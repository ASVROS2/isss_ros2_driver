<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>isss_proc</name>
  <version>0.1.0</version>
  <description>ROS-free processing of DeepVision ISSS pings (Python module `isss_proc`): filters from phase and intensity to trusted soundings</description>
  <maintainer email="jvaldez@kth.se">Julian Valdez</maintainer>
  <license>MIT</license>

  <exec_depend>isss_core</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
